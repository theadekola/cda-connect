{
  "name": "cda-connect-frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@some19ice/nigeria-geo-core": "^0.1.4",
    "@tanstack/react-query": "^5.85.3",
    "axios": "^1.11.0",
    "country-state-city": "^3.2.1",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-calendar": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.15",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.15",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  }
}
