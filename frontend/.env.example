# Public backend API (Nginx/Cloudflare forwards to the authenticated Node service).
VITE_API_URL=https://api.cdaconnect.org/api/v1

# Backend Socket.IO origin.
VITE_SOCKET_URL=https://api.cdaconnect.org

# Optional WebRTC ICE servers, including your TURN relay for restrictive networks.
# Supply JSON through your build environment. Use deployment-specific TURN credentials.
VITE_RTC_ICE_SERVERS=

# Optional public website origin for copied links. Defaults to the configured API origin.
VITE_PUBLIC_ORIGIN=https://cdaconnect.org
