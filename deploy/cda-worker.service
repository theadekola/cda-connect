[Unit]
Description=CDA Connect background worker
After=network-online.target cda-redis.service cda-api.service
Wants=network-online.target
Requires=cda-redis.service
[Service]
Type=simple
User=cda-app
Group=cda-app
WorkingDirectory=/var/lib/cda-connect
EnvironmentFile=/etc/cda-connect/backend.env
ExecStart=/usr/bin/node /opt/cda-connect/current/backend/dist/workers/worker.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cda-connect
[Install]
WantedBy=multi-user.target
