# Generate on the Ubuntu VM using openssl rand -hex 32. Hex avoids URL escaping.
REDIS_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
CDA_DOMAIN=cdaconnect.org
# JSON array. Add a credentialed TURN/TURNS relay before enabling public calls.
RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"],"username":"replace-with-turn-username","credential":"replace-with-turn-credential"}]
