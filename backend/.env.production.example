NODE_ENV=production
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=https://cdaconnect.org
DB_SERVER=REPLACE_WITH_PRIVATE_DATABASE_HOST
DB_PORT=1433
DB_NAME=CDAConnect
DB_USER=community_app
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_ENCRYPT=true
DB_TRUST_CERT=false
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
PUBLIC_BASE_URL=https://cdaconnect.org
# Native universal/app links. Use the Apple App ID prefix and Google Play app-signing certificate.
# Configure the installed environment with: sudo python3 deploy/setup-app-links.py
IOS_APP_ID=
ANDROID_APP_LINK_SHA256=
PLATFORM_ADMIN_EMAILS=
# Supply only while running `npm run setup:super-admin`, then remove from the environment.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
SUPER_ADMIN_PERMISSIONS=PLATFORM_AUDIT_VIEW
LANGUAGE_SERVICE_URL=
LANGUAGE_SERVICE_API_KEY=
AI_SERVICE_URL=http://127.0.0.1:8001/answer
# Private FastAPI shared key is generated by deploy/setup-ai.py.
AI_SERVICE_API_KEY=
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=180
STORAGE_DRIVER=local
STORAGE_BUCKET=cda-connect
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_CODE_EXPIRES_MINUTES=10
SMS_RESEND_SECONDS=60
ALLOW_PHONE_VERIFICATION_BYPASS=false
EMERGENCY_BATCH_SIZE=1000

# Optional coturn REST authentication. Set real values only in /etc/cda-connect/backend.env.
# deploy/setup-turn.py --app configures these interactively on the app VM.
# RTC_TURN_URLS=turn:your-relay-host:3478?transport=udp,turn:your-relay-host:3478?transport=tcp
# RTC_TURN_SECRET= (64 hex characters, same shared secret as coturn)
RTC_TURN_TTL_SECONDS=3600

# Set true temporarily to verify calls use TURN; restore false after testing.
RTC_RELAY_ONLY=false

# Required for production uploads. Install clamd and allow the API service user access.
CLAMAV_SOCKET=/run/clamav/clamd.ctl
