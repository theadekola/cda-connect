NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
DB_SERVER=192.168.10.101
DB_PORT=1433
DB_NAME=CDAConnect
DB_USER=community_app
DB_PASSWORD=change-me
DB_ENCRYPT=true
DB_TRUST_CERT=true
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

PUBLIC_BASE_URL=http://192.168.10.220:4000
# Optional provider for automatic translation, simple-language rewriting and transcription
LANGUAGE_SERVICE_URL=
LANGUAGE_SERVICE_API_KEY=

# Comma-separated CDA Connect platform reviewers allowed to approve verification evidence
PLATFORM_ADMIN_EMAILS=

# Optional server-side AI provider adapter. Must accept {question, context, mode}.
AI_SERVICE_URL=
AI_SERVICE_API_KEY=


# Redis: cache, presence, rate limits, BullMQ, Socket.IO adapter
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=180

# Object storage. Use s3 for MinIO, AWS S3, Cloudflare R2 or another S3-compatible provider.
STORAGE_DRIVER=s3
STORAGE_BUCKET=cda-connect
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://192.168.10.230:9000
STORAGE_ACCESS_KEY_ID=cda-connect
STORAGE_SECRET_ACCESS_KEY=change-me-object-storage-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=http://192.168.10.230:9000/cda-connect

# Optional notification provider adapters used by workers
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_CODE_EXPIRES_MINUTES=10
SMS_RESEND_SECONDS=60
# Development/testing only. Ignored when NODE_ENV=production.
ALLOW_PHONE_VERIFICATION_BYPASS=false
EMERGENCY_BATCH_SIZE=1000

# Optional Open-Meteo customer key for commercial weather API usage.
OPEN_METEO_API_KEY=

# Optional operational alerts. Store the real webhook only in the server environment.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
