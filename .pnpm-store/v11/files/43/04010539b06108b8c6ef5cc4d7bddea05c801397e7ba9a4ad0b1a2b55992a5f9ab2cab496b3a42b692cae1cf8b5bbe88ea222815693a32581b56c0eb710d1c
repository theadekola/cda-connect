=> (result.score ?? 1) <= threshold)\n    .map((result) => ({\n      item: result.item,\n      score: 1 - (result.score ?? 0), // Convert to 0-1 where 1 is best\n      matches: result.matches?.map((match) => ({\n        key: match.key ?? '',\n        value: match.value ?? '',\n        indices: match.indices as Array<[number, number]>,\n      })),\n    }));\n}\n\n/**\n * Search for LGAs matching the query\n * @param query - Search string\n * @param options - Search options\n * @returns Array of matching LGAs with scores\n */\nexport function searchLGAs(\n  query: string,\n  options: Omit<SearchOptions, 'type'> = {}\n): SearchResult<LGA>[] {\n  const { limit = 10, threshold = 0.3, stateId } = options;\n\n  // If stateId is provided, filter LGAs first\n  let searchCollection = lgas;\n  if (stateId) {\n    searchCollection = lgas.filter((lga) => lga.stateId === stateId);\n  }\n\n  // Create a new Fuse instance if filtering by state\n  const fuse = stateId ? new Fuse(searchCollection, lgasFuseOptions) : lgasFuse;\n\n  const results = fuse.search(query, { limit });\n\n  return results\n    .filter((result) => (result.score ?? 1) <= threshold)\n    .map((result) => ({\n      item: result.item,\n      score: 1 - (result.score ?? 0),\n      matches: result.matches?.map((match) => ({\n        key: match.key ?? '',\n        value: match.value ?? '',\n        indices: match.indices as Array<[number, number]>,\n      })),\n    }));\n}\n\n/**\n * Search for both states and LGAs matching the query\n * @param query - Search string\n * @param options - Search options\n * @returns Array of matching locations with scores\n */\nexport function searchLocations(\n  query: string,\n  options: SearchOptions = {}\n): SearchResult<State | LGA>[] {\n  const { type = 'all', limit = 10 } = options;\n\n  let results: SearchResult<State | LGA>[] = [];\n\n  if (type === 'state' || type === 'all') {\n    results = results.concat(searchStates(query, options));\n  }\n\n  if (type === 'lga' || type === 'all') {\n    results = results.concat(searchLGAs(query, options));\n  }\n\n  // Sort by score (descending) and limit\n  return results.sort((a, b) => b.score - a.score).slice(0, limit);\n}\n","/**\n * @nigeria-geo/core\n * The definitive geographic data for Nigeria - States, LGAs, and search utilities\n *\n * @packageDocumentation\n */\n\n// Re-export all types\nexport type {\n  Coordinates,\n  BoundingBox,\n  GeopoliticalZone,\n  State,\n  LGA,\n  Location,\n  SearchOptions,\n  SearchResult,\n  NigeriaGeoData,\n} from './types';\n\n// Import data\nimport statesData from './data/states.json';\nimport lgasData from './data/lgas.json';\nimport type { State, LGA } from './types';\n\n// Type assertions\nconst states = statesData as State[];\nconst lgas = lgasData as LGA[];\n\n// Re-export search functions\nexport { searchStates, searchLGAs, searchLocations } from './search';\n\n/**\n * Get all Nigerian states (36 states + FCT)\n * @returns Array of all states\n */\nexport function getStates(): State[] {\n  return [...states];\n}\n\n/**\n * Get a state by its ID\n * @param id - State ID (slug format, e.g., 'lagos', 'fct')\n * @returns The state or undefined if not found\n */\nexport function getStateById(id: string): State | undefined {\n  return states.find((state) => state.id === id);\n}\n\n/**\n * Get a state by its name (case-insensitive)\n * @param name - State name (e.g., 'Lagos', 'Federal Capital Territory')\n * @returns The state or undefined if not found\n */\nexport function getStateByName(name: string): State | undefined {\n  const normalizedName = name.toLowerCase().trim();\n  return states.find((state) => state.name.toLowerCase() === normalizedName);\n}\n\n/**\n * Get all states in a geopolitical zone\n * @param zone - The geopolitical zone\n * @returns Array of states in that zone\n */\nexport function getStatesByZone(\n  zone:\n    | 'North Central'\n    | 'North East'\n    | 'North West'\n    | 'South East'\n    | 'South South'\n    | 'South West'\n): State[] {\n  return states.filter((state) => state.zone === zone);\n}\n\n/**\n * Get all LGAs\n * @returns Array of all 774 LGAs\n */\nexport function getLGAs(): LGA[] {\n  return [...lgas];\n}\n\n/**\n * Get an LGA by its ID\n * @param id - LGA ID (slug format, e.g., 'ikeja', 'kano-municipal')\n * @returns The LGA or undefined if not found\n */\nexport function getLGAById(id: string): LGA | undefined {\n  return lgas.find((lga) => lga.id === id);\n}\n\n/**\n * Get all LGAs in a state\n * @param stateId - State ID\n * @returns Array of LGAs in that state\n */\nexport function getLGAsByState(stateId: string): LGA[] {\n  return lgas.filter((lga) => lga.stateId === stateId);\n}\n\n/**\n * Get an LGA by its name within a state (case-insensitive)\n * @param name - LGA name\n * @param stateId - Parent state ID\n * @returns The LGA or undefined if not found\n */\nexport function getLGAByName(name: string, stateId?: string): LGA | undefined {\n  const normalizedName = name.toLowerCase().trim();\n  return lgas.find(\n    (lga) =>\n      lga.name.toLowerCase() === normalizedName &&\n      (stateId === undefined || lga.stateId === stateId)\n  );\n}\n\n/**\n * Get complete Nigeria geographic data\n * @returns Object containing all states and LGAs with metadata\n */\nexport function getAllData(): {\n  states: State[];\n  lgas: LGA[];\n  meta: { version: string; stateCount: number; lgaCount: number };\n} {\n  return {\n    states: getStates(),\n    lgas: getLGAs(),\n    meta: {\n      version: '0.0.1',\n      stateCount: states.length,\n      lgaCount: lgas.length,\n    },\n  };\n}\n\n/**\n * Get the total count of states\n * @returns Number of states (37 including FCT)\n */\nexport function getStateCount(): number {\n  return states.length;\n}\n\n/**\n * Get the total count of LGAs\n * @returns Number of LGAs\n */\nexport function getLGACount(): number {\n  return lgas.length;\n}\n"]}