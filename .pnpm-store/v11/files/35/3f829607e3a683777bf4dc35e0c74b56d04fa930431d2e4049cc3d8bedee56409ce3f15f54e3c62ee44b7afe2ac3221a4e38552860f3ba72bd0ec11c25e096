{
  "name": "@some19ice/nigeria-geo-core",
  "version": "0.1.4",
  "description": "Core geographic data for Nigeria - States, LGAs, and search utilities",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "nigeria",
    "geography",
    "states",
    "lga",
    "local-government-area",
    "geolocation",
    "coordinates"
  ],
  "author": "Nigeria Geo Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Some19ice/nigeria-geo.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Some19ice/nigeria-geo/issues"
  },
  "homepage": "https://github.com/Some19ice/nigeria-geo#readme",
  "dependencies": {
    "fuse.js": "^7.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}